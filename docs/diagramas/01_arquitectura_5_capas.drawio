<mxfile host="app.diagrams.net"><diagram id="arquitectura_5_capas" name="arquitectura_5_capas"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2800" pageHeight="1400" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Arquitectura de BI del Observatorio Distrital de Actividad Económica, Turismo y Seguridad (Bogotá D.C.)" style="text;html=1;align=center;verticalAlign=top;whiteSpace=wrap;fontSize=36;fontColor=#1F2937;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="18" width="2720" height="50" as="geometry"/></mxCell><mxCell id="c3" value="Despliegue on-premise (local) · flujo de datos de izquierda a derecha" style="text;html=1;align=center;verticalAlign=top;whiteSpace=wrap;fontSize=26;fontColor=#6B7280;" vertex="1" parent="1"><mxGeometry x="40" y="68" width="2720" height="36" as="geometry"/></mxCell><mxCell id="c4" value="1. Fuentes de datos" style="swimlane;html=1;startSize=64;rounded=1;fillColor=#2563EB;strokeColor=#2563EB;swimlaneFillColor=#EAF1FB;fontStyle=1;fontSize=32;fontColor=#FFFFFF;swimlaneHead=1;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="500" height="940" as="geometry"/></mxCell><mxCell id="c5" value="2. Integración (ETL)" style="swimlane;html=1;startSize=64;rounded=1;fillColor=#D97706;strokeColor=#D97706;swimlaneFillColor=#FFF4E5;fontStyle=1;fontSize=32;fontColor=#FFFFFF;swimlaneHead=1;" vertex="1" parent="1"><mxGeometry x="630" y="120" width="860" height="940" as="geometry"/></mxCell><mxCell id="c6" value="3. Almacén de datos" style="swimlane;html=1;startSize=64;rounded=1;fillColor=#15803D;strokeColor=#15803D;swimlaneFillColor=#EAF7EE;fontStyle=1;fontSize=32;fontColor=#FFFFFF;swimlaneHead=1;" vertex="1" parent="1"><mxGeometry x="1580" y="120" width="520" height="940" as="geometry"/></mxCell><mxCell id="c7" value="4. Usuario final" style="swimlane;html=1;startSize=64;rounded=1;fillColor=#7E22CE;strokeColor=#7E22CE;swimlaneFillColor=#F3EAFB;fontStyle=1;fontSize=32;fontColor=#FFFFFF;swimlaneHead=1;" vertex="1" parent="1"><mxGeometry x="2190" y="120" width="570" height="940" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b style=&quot;font-size:26px&quot;&gt;F1 · Alojamiento turístico&lt;/b&gt;&lt;br&gt;&lt;br&gt;turismo.geojson&lt;br&gt;Formato: GeoJSON (EPSG:3857)&lt;br&gt;839 establecimientos&lt;br&gt;" style="rounded=1;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=14;fontSize=22;fillColor=#FFFFFF;strokeColor=#2563EB;strokeWidth=3;fontColor=#1F2937;" vertex="1" parent="c4"><mxGeometry x="30" y="85" width="440" height="200" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b style=&quot;font-size:26px&quot;&gt;F2 · Hurto por modalidades&lt;/b&gt;&lt;br&gt;&lt;br&gt;Reporte_Hurto_por_Modalidades_&lt;br&gt;con_LOCALIDAD.csv&lt;br&gt;Formato: CSV (Policía Nacional)&lt;br&gt;653.384 filas; 176.776 de Bogotá&lt;br&gt;" style="rounded=1;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=14;fontSize=22;fillColor=#FFFFFF;strokeColor=#2563EB;strokeWidth=3;fontColor=#1F2937;" vertex="1" parent="c4"><mxGeometry x="30" y="297" width="440" height="200" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b style=&quot;font-size:26px&quot;&gt;F3 · Dinámica empresarial&lt;/b&gt;&lt;br&gt;&lt;br&gt;dinamicaempresarial2023 / 2024 / 2025.gpkg&lt;br&gt;Formato: GeoPackage (EPSG:4326)&lt;br&gt;Empresas y establecimientos vigentes&lt;br&gt;" style="rounded=1;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=14;fontSize=22;fillColor=#FFFFFF;strokeColor=#2563EB;strokeWidth=3;fontColor=#1F2937;" vertex="1" parent="c4"><mxGeometry x="30" y="509" width="440" height="200" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b style=&quot;font-size:26px&quot;&gt;F4 · Localidad&lt;/b&gt;&lt;br&gt;&lt;br&gt;geografia.json&lt;br&gt;Formato: JSON (EPSG:4686)&lt;br&gt;20 localidades de Bogotá&lt;br&gt;" style="rounded=1;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=14;fontSize=22;fillColor=#FFFFFF;strokeColor=#2563EB;strokeWidth=3;fontColor=#1F2937;" vertex="1" parent="c4"><mxGeometry x="30" y="721" width="440" height="200" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b style=&quot;font-size:27px&quot;&gt;Extracción&lt;/b&gt;&lt;br&gt;&lt;br&gt;Python (pandas y GeoPandas) lee los archivos GPKG, GeoJSON, CSV y JSON desde datos/raw&lt;br&gt;" style="rounded=1;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=14;fontSize=24;fillColor=#FFFFFF;strokeColor=#D97706;strokeWidth=3;fontColor=#1F2937;" vertex="1" parent="c5"><mxGeometry x="30" y="85" width="270" height="830" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b style=&quot;font-size:27px&quot;&gt;Staging&lt;/b&gt;&lt;br&gt;&lt;br&gt;Tablas de paso en PostgreSQL (esquema stg) con los datos tal como llegan&lt;br&gt;" style="rounded=1;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=14;fontSize=25;fillColor=#FFFFFF;strokeColor=#D97706;strokeWidth=3;fontColor=#1F2937;" vertex="1" parent="c5"><mxGeometry x="360" y="85" width="470" height="170" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b style=&quot;font-size:27px&quot;&gt;Transformación (Pentaho PDI)&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Normalizar FECHA HECHO y validar CANTIDAD&lt;br&gt;• Limpiar categorías; marcar nulos, duplicados potenciales y registros fuera de Bogotá&lt;br&gt;• Normalizar LOCCODIGO a 2 caracteres; relacionar LOCALIDAD con LocCodigo&lt;br&gt;• Reproyectar F1 y F4 a EPSG:4326&lt;br&gt;• Construir DIM_TIEMPO y llaves sustitutas&lt;br&gt;" style="rounded=1;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=14;fontSize=25;fillColor=#FFFFFF;strokeColor=#D97706;strokeWidth=3;fontColor=#1F2937;" vertex="1" parent="c5"><mxGeometry x="360" y="290" width="470" height="480" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b style=&quot;font-size:27px&quot;&gt;Carga al DW (Pentaho PDI)&lt;/b&gt;&lt;br&gt;&lt;br&gt;Dimensiones y luego hechos&lt;br&gt;" style="rounded=1;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=14;fontSize=25;fillColor=#FFFFFF;strokeColor=#D97706;strokeWidth=3;fontColor=#1F2937;" vertex="1" parent="c5"><mxGeometry x="360" y="805" width="470" height="110" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b style=&quot;font-size:27px&quot;&gt;PostgreSQL · esquema dw&lt;/b&gt;&lt;br&gt;&lt;br&gt;Tablas de hechos&lt;br&gt;• FACT_DINAMICA_EMPRESARIAL&lt;br&gt;• FACT_ALOJAMIENTO&lt;br&gt;• FACT_HURTOS&lt;br&gt;&lt;br&gt;Dimensiones conformadas&lt;br&gt;• DIM_TIEMPO&lt;br&gt;• DIM_LOCALIDAD&lt;br&gt;• DIM_TIPO_ALOJAMIENTO&lt;br&gt;• DIM_TIPO_HURTO&lt;br&gt;• DIM_CARACTERISTICA_HURTO&lt;br&gt;&lt;br&gt;Modelo: constelación de hechos con esquemas estrella&lt;br&gt;" style="rounded=1;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=14;fontSize=23;fillColor=#FFFFFF;strokeColor=#15803D;strokeWidth=3;fontColor=#1F2937;" vertex="1" parent="c6"><mxGeometry x="30" y="85" width="460" height="830" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b style=&quot;font-size:27px&quot;&gt;Dashboard (Pentaho)&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Filtros por tiempo, tipo de hurto y localidad&lt;br&gt;• Evolución de empresas, establecimientos y hurtos&lt;br&gt;• Tablas comparativas por localidad&lt;br&gt;• Hurtos por tipo y por periodo&lt;br&gt;• Responde las preguntas P0 a P4&lt;br&gt;" style="rounded=1;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=14;fontSize=27;fillColor=#FFFFFF;strokeColor=#7E22CE;strokeWidth=3;fontColor=#1F2937;" vertex="1" parent="c7"><mxGeometry x="30" y="85" width="510" height="470" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b style=&quot;font-size:27px&quot;&gt;Dirección del observatorio&lt;/b&gt;&lt;br&gt;&lt;br&gt;Decisor: compara actividad empresarial, alojamiento turístico y hurtos por modalidad&lt;br&gt;" style="rounded=1;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=14;fontSize=26;fillColor=#FFFFFF;strokeColor=#7E22CE;strokeWidth=3;fontColor=#1F2937;" vertex="1" parent="c7"><mxGeometry x="30" y="640" width="510" height="275" as="geometry"/></mxCell><mxCell id="c19" value="5. Gobierno, metadatos, monitoreo y seguridad (capa transversal)" style="swimlane;html=1;startSize=64;rounded=1;fillColor=#4B5563;strokeColor=#4B5563;swimlaneFillColor=#F3F4F6;fontStyle=1;fontSize=32;fontColor=#FFFFFF;swimlaneHead=1;" vertex="1" parent="1"><mxGeometry x="40" y="1110" width="2720" height="250" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b style=&quot;font-size:26px&quot;&gt;Diccionarios de datos&lt;/b&gt;&lt;br&gt;&lt;br&gt;/datos/diccionarios y Anexo A del informe&lt;br&gt;" style="rounded=1;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=14;fontSize=22;fillColor=#FFFFFF;strokeColor=#4B5563;strokeWidth=3;fontColor=#1F2937;" vertex="1" parent="c19"><mxGeometry x="30" y="85" width="510" height="150" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b style=&quot;font-size:26px&quot;&gt;Reglas de transformación&lt;/b&gt;&lt;br&gt;&lt;br&gt;Documentadas por fuente y campo, versionadas en GitHub&lt;br&gt;" style="rounded=1;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=14;fontSize=22;fillColor=#FFFFFF;strokeColor=#4B5563;strokeWidth=3;fontColor=#1F2937;" vertex="1" parent="c19"><mxGeometry x="564" y="85" width="510" height="150" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b style=&quot;font-size:26px&quot;&gt;Monitoreo de calidad&lt;/b&gt;&lt;br&gt;&lt;br&gt;Conciliación de filas y suma de CANTIDAD entre fuente y almacén (dw/conciliacion)&lt;br&gt;" style="rounded=1;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=14;fontSize=22;fillColor=#FFFFFF;strokeColor=#4B5563;strokeWidth=3;fontColor=#1F2937;" vertex="1" parent="c19"><mxGeometry x="1098" y="85" width="510" height="150" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b style=&quot;font-size:26px&quot;&gt;Control de versiones&lt;/b&gt;&lt;br&gt;&lt;br&gt;Repositorio GitHub del equipo: datos, ETL, DDL y diagramas&lt;br&gt;" style="rounded=1;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=14;fontSize=22;fillColor=#FFFFFF;strokeColor=#4B5563;strokeWidth=3;fontColor=#1F2937;" vertex="1" parent="c19"><mxGeometry x="1632" y="85" width="510" height="150" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b style=&quot;font-size:26px&quot;&gt;Seguridad y acceso&lt;/b&gt;&lt;br&gt;&lt;br&gt;Acceso restringido a la base de datos local; datos públicos sin información personal&lt;br&gt;" style="rounded=1;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=14;fontSize=22;fillColor=#FFFFFF;strokeColor=#4B5563;strokeWidth=3;fontColor=#1F2937;" vertex="1" parent="c19"><mxGeometry x="2166" y="85" width="510" height="150" as="geometry"/></mxCell><mxCell id="c25" value="" style="endArrow=block;endFill=1;html=1;strokeWidth=5;strokeColor=#374151;endSize=10;" edge="1" parent="1" source="c8" target="c12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c26" value="" style="endArrow=block;endFill=1;html=1;strokeWidth=5;strokeColor=#374151;endSize=10;" edge="1" parent="1" source="c9" target="c12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c27" value="" style="endArrow=block;endFill=1;html=1;strokeWidth=5;strokeColor=#374151;endSize=10;" edge="1" parent="1" source="c10" target="c12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c28" value="" style="endArrow=block;endFill=1;html=1;strokeWidth=5;strokeColor=#374151;endSize=10;" edge="1" parent="1" source="c11" target="c12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c29" value="" style="endArrow=block;endFill=1;html=1;strokeWidth=5;strokeColor=#374151;endSize=10;exitX=1;exitY=0.102;exitDx=0;exitDy=0;en