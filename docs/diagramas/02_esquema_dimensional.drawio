lt;b&amp;nbsp;style=&quot;color:#1D4ED8&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;/b&gt;&amp;nbsp;&amp;nbsp;etiqueta (por verificar)" style="text;html=1;align=left;verticalAlign=middle;fontSize=24;spacingLeft=10;" vertex="1" parent="c11"><mxGeometry x="0" y="134" width="520" height="40" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b style=&quot;font-size:26px&quot;&gt;Notas del modelo&lt;/b&gt;&lt;br&gt;&lt;br&gt;• FACT_HURTOS: un registro de la fuente policial (fecha, tipo de hurto, características y CANTIDAD).&lt;br&gt;• FACT_DINAMICA_EMPRESARIAL: una localidad en un corte de medición.&lt;br&gt;• FACT_ALOJAMIENTO: un establecimiento (reg_rnt) en la fecha de corte.&lt;br&gt;• sk_localidad de FACT_HURTOS se obtiene con una tabla de equivalencia de nombres y códigos oficiales.&lt;br&gt;• Cardinalidad 1 : N desde cada dimensión hacia cada hecho.&lt;br&gt;" style="rounded=1;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=14;fontSize=22;fillColor=#FFFFFF;strokeColor=#6B7280;strokeWidth=3;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="60" y="1250" width="1100" height="300" as="geometry"/></mxCell><mxCell id="c12" value="" style="endArrow=ERmany;endSize=26;startArrow=ERone;startSize=26;html=1;strokeWidth=4;strokeColor=#374151;fontColor=#374151;fontStyle=1;fontSize=24;" edge="1" parent="1" source="c4" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c63" value="1" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=30;fontStyle=1;fontColor=#B91C1C;" vertex="1" connectable="0" parent="c12"><mxGeometry x="-0.6" relative="1" as="geometry"><mxPoint y="-22" as="offset"/></mxGeometry></mxCell><mxCell id="c64" value="N" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=30;fontStyle=1;fontColor=#B91C1C;" vertex="1" connectable="0" parent="c12"><mxGeometry x="0.6" relative="1" as="geometry