    <entry>
      <name>Calcular variación % y participación %</name>
      <description/>
      <type>SQL</type>
      <attributes/>
      <sql>UPDATE dw.fact_dinamica_empresarial f
   SET variacion_empresas_pct = CASE WHEN x.emp_ant IS NULL OR x.emp_ant = 0 THEN NULL
         ELSE ROUND((f.empresas_vigentes - x.emp_ant)::numeric * 100 / x.emp_ant, 4) END,
       variacion_establecimientos_pct = CASE WHEN x.est_ant IS NULL OR x.est_ant = 0 OR f.establecimientos_vigentes IS NULL THEN NULL
         ELSE ROUND((f.establecimientos_vigentes - x.est_ant)::numeric * 100 / x.est_ant, 4) END
  FROM (SELECT sk_localidad, sk_tiempo,
               LAG(empresas_vigentes) OVER w AS emp_ant, LAG(establecimientos_vigentes) OVER w AS est_ant
          FROM dw.fact_dinamica_empresarial WINDOW w AS (PARTITION BY sk_localidad ORDER BY sk_tiempo)) x
 WHERE f.sk_localidad = x.sk_localidad AND f.sk_tiempo = x.sk_tiempo;
UPDATE dw.fact_alojamiento f
   SET participacion_pct = ROUND(100.0 * x.n_loc / x.n_total, 4)
  FROM (SELECT reg_rnt, COUNT(*) OVER (PARTITION BY sk_localidad) AS n_loc, COUNT(*) OVER () AS n_total
          FROM dw.fact_alojamiento) x
 WHERE f.reg_rnt = x.reg_rnt;</sql>
