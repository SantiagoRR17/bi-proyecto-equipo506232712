    <entry>
      <name>Limpiar DW (conserva miembros -1)</name>
      <description/>
      <type>SQL</type>
      <attributes/>
      <sql>DELETE FROM dw.fact_hurtos;
DELETE FROM dw.fact_alojamiento;
DELETE FROM dw.fact_dinamica_empresarial;
DELETE FROM dw.dim_tiempo;
DELETE FROM dw.dim_localidad WHERE sk_localidad &lt;&gt; -1;
DELETE FROM dw.dim_tipo_alojamiento WHERE sk_tipo_alojamiento &lt;&gt; -1;
DELETE FROM dw.dim_tipo_hurto WHERE sk_tipo_hurto &lt;&gt; -1;
DELETE FROM dw.dim_caracteristica_hurto WHERE sk_caracteristica &lt;&gt; -1;</sql>
      <useVariableSubstitution>F</useVariableSubstitution>
      <sqlfromfile>F</sqlfromfile>
      <sqlfilename/>
      <sendOneStatement>T</sendOneStatement>
      <connection>dw</connection>
      <parallel>N</parallel>
