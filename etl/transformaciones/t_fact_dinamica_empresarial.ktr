<step><name>P13-F3 2023 detalle agregado por localidad y corte (Periodo/Mes)</name><type>TableInput</type><description/><distribute>Y</distribute><custom_distribution/><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning><connection>gpkg2023</connection><sql>SELECT e.loc AS loc_texto, e.emp AS empresas, s.est AS establecimientos, (SELECT MAX(Periodo * 10000 + Mes * 100 + 1) FROM Empresas) AS sk_tiempo FROM (SELECT LOCNOMBRE AS loc, SUM(empresasvigentes) AS emp FROM Empresas GROUP BY LOCNOMBRE) e LEFT JOIN (SELECT LOCNOMBRE AS loc, SUM(Establecimientosvigentes) AS est FROM Establecimientos GROUP BY LOCNOMBRE) s ON s.loc = e.loc</sql><limit>0</limit><lookup/><execute_each_row>N</execute_each_row><variables_active>N</variables_active><lazy_conversion_active>N</lazy_conversion_active><cluster_schema/><remotesteps><input></input><output></output></remotesteps><GUI><xloc>40</xloc><yloc>40</yloc><draw>Y</draw></GUI></step>
