<step><name>P09-F2 Normalizar LOCALIDAD (tildes y mayusculas)</name><type>ScriptValueMod</type><description/><distribute>Y</distribute><custom_distribution/><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning><compatible>N</compatible><optimizationLevel>9</optimizationLevel><jsScripts><jsScript><jsScript_type>0</jsScript_type><jsScript_name>Transformacion</jsScript_name><jsScript_script>function cl(x) { if (x == null) return ''; return String(x).replace(/\s+/g, ' ').replace(/^ | $/g, ''); }
function norm(x) {
  var s = cl(x).toUpperCase();
  s = s.replace(/[ÁÀÂÄ]/g, 'A').replace(/[ÉÈÊË]/g, 'E').replace(/[ÍÌÎÏ]/g, 'I')
       .replace(/[ÓÒÔÖ]/g, 'O').replace(/[ÚÙÛÜ]/g, 'U').replace(/Ñ/g, 'N');
  return s;
}
function claveLoc(x) {
  var s = cl(x);
  if (/^[0-9]+(\.0+)?$/.test(s)) { s = s.replace(/\.0+$/, ''); return ('00' + s).slice(-2); }
  return norm(s);
}

clave_loc = claveLoc(localidad_txt);
if (clave_loc == '') c_localidad_vacia++;</jsScript_script></jsScript><jsScript><jsScript_type>1</jsScript_type><jsScript_name>Inicio</jsScript_name><jsScript_script>var c_localidad_vacia = 0;</jsScript_script></jsScript><jsScript><jsScript_type>2</jsScript_type><jsScript_name>Fin</jsScript_name><jsScript_script>writeToLog('m', 'P09-F2 Normalizar LOCALIDAD (tildes y mayusculas) | c_localidad_vacia: ' + c_localidad_vacia);</jsScript_script></jsScript></jsScripts><fields><field><name>clave_loc</name><rename>clave_loc</rename><type>String</type><length>-1</length><precision>-1</precision><replace>N</replace></field></fields><cluster_schema/><remotesteps><input></input><output></output></remotesteps><GUI><xloc>1790</xloc><yloc>140</yloc><draw>Y</draw></GUI></step>
