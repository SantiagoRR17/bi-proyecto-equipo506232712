<step><name>P04-F2 Verificar MUNICIPIO y CODIGO DANE de Bogota</name><type>ScriptValueMod</type><description/><distribute>Y</distribute><custom_distribution/><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning><compatible>N</compatible><optimizationLevel>9</optimizationLevel><jsScripts><jsScript><jsScript_type>0</jsScript_type><jsScript_name>Transformacion</jsScript_name><jsScript_script>if (String(codigo_dane) != '11001000' || String(municipio).indexOf('D.C.') &lt; 0) c_municipio_dane_incoherente++;</jsScript_script></jsScript><jsScript><jsScript_type>1</jsScript_type><jsScript_name>Inicio</jsScript_name><jsScript_script>var c_municipio_dane_incoherente = 0;</jsScript_script></jsScript><jsScript><jsScript_type>2</jsScript_type><jsScript_name>Fin</jsScript_name><jsScript_script>writeToLog('m', 'P04-F2 Verificar MUNICIPIO y CODIGO DANE de Bogota | c_municipio_dane_incoherente: ' + c_municipio_dane_incoherente);</jsScript_script></jsScript></jsScripts><fields></fields><cluster_schema/><remotesteps><input></input><output></output></remotesteps><GUI><xloc>565</xloc><yloc>140</yloc><draw>Y</draw></GUI></step>
<step><name>P05-F2 Convertir FECHA HECHO (dd/mm/aaaa) a sk_tiempo</name><type>ScriptValueMod</type><description/><distribute>Y</distribute><custom_distribution/><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning><compatible>N</compatible><optimizationLevel>9</optimizationLevel><jsScripts><jsScript><jsScript_type>0</jsScript_type><jsScript_name>Transformacion</jsScript_name><jsScript_script>function cl(x) { if (x == null) return ''; return String(x).replace(/\s+/g, ' ').replace(/^ | $/g, ''); }
function norm(x) {
  var s = cl(x).toUpperCase();
  s = s.replace(/[ÁÀÂÄ]/g, 'A').replace(/[ÉÈÊË]/g, 'E').replace(/[ÍÌÎÏ]/g, 'I')
       .replace(/[ÓÒÔÖ]/g, 'O').replace(/[ÚÙÛÜ]/g, 'U').replace(/Ñ/g, 'N');
  return s;
}
function claveLoc(x) {
  var s = cl(x);
  if (/^[0-9]+(\.0+)?$/.test(s)) { s = s.replace(/\.0+$/, ''); return ('00' + s).slice(-2); }
  return norm(s);
}

fecha_ok = 0; sk_tiempo = null;
var m = /^(\d{1,2})\/(\d{1,2})\/(\d{4})$/.exec(cl(fecha_hecho));
if (m) {
  var d = parseInt(m[1], 10), mo = parseInt(m[2], 10), y = parseInt(m[3], 10);
  var dt = new Date(y, mo - 1, d);
  if (dt.getFullYear() == y &amp;&amp; dt.getMonth() == mo - 1 &amp;&amp; dt.getDate() == d &amp;&amp; y &gt;= 2010 &amp;&amp; y &lt;= 2026) {
    sk_tiempo = y * 10000 + mo * 100 + d; fecha_ok = 1;
  }
}
if (fecha_ok == 0) c_fecha_invalida++;</jsScript_script></jsScript><jsScript><jsScript_type>1</jsScript_type><jsScript_name>Inicio</jsScript_name><jsScript_script>var c_fecha_invalida = 0;</jsScript_script></jsScript><jsScript><jsScript_type>2</jsScript_type><jsScript_name>Fin</jsScript_name><jsScript_script>writeToLog('m', 'P05-F2 Convertir FECHA HECHO (dd/mm/aaaa) a sk_tiempo | c_fecha_invalida: ' + c_fecha_invalida);</jsScript_script></jsScript></jsScripts><fields><field><name>fecha_ok</name><rename>fecha_ok</rename><type>Integer</type><length>-1</length><precision>-1</precision><replace>N</replace></field><field><name>sk_tiempo</name><rename>sk_tiempo</rename><type>Integer</type><length>-1</length><precision>-1</precision><replace>N</replace></field></fields><cluster_schema/><remotesteps><input></input><output></output></remotesteps><GUI><xloc>740</xloc><yloc>40</yloc><draw>Y</draw></GUI></step>
<step><name>P06-F2 Validar CANTIDAD entera mayor que 0</name><type>ScriptValueMod</type><description/><distribute>Y</distribute><custom_distribution/><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning><compatible>N</compatible><optimizationLevel>9</optimizationLevel><jsScripts><jsScript><jsScript_type>0</jsScript_type><jsScript_name>Transformacion</jsScript_name><jsScript_script>function cl(x) { if (x == null) return ''; return String(x).replace(/\s+/g, ' ').replace(/^ | $/g, ''); }
function norm(x) {
  var s = cl(x).toUpperCase();
  s = s.replace(/[ÁÀÂÄ]/g, 'A').replace(/[ÉÈÊË]/g, 'E').replace(/[ÍÌÎÏ]/g, 'I')
       .replace(/[ÓÒÔÖ]/g, 'O').replace(/[ÚÙÛÜ]/g, 'U').replace(/Ñ/g, 'N');
  return s;
}
function claveLoc(x) {
  var s = cl(x);
  if (/^[0-9]+(\.0+)?$/.test(s)) { s = s.replace(/\.0+$/, ''); return ('00' + s).slice(-2); }
  return norm(s);
}

var q = parseInt(cl(cantidad), 10);
cantidad_n = isNaN(q) ? null : q;
cant_ok = (cantidad_n != null &amp;&amp; cantidad_n &gt; 0) ? 1 : 0;
if (cant_ok == 0) c_cantidad_invalida++;</jsScript_script></jsScript><jsScript><jsScript_type>1</jsScript_type><jsScript_name>Inicio</jsScript_name><jsScript_script>var c_cantidad_invalida = 0;</jsScript_script></jsScript><jsScript><jsScript_type>2</jsScript_type><jsScript_name>Fin</jsScript_name><jsScript_script>writeToLog('m', 'P06-F2 Validar CANTIDAD entera mayor que 0 | c_cantidad_invalida: ' + c_cantidad_invalida);</jsScript_script></jsScript></jsScripts><fields><field><name>cantidad_n</name><rename>cantidad_n</rename><type>Integer</type><length>-1</length><precision>-1</precision><replace>N</replace></field><field><name>cant_ok</name><rename>cant_ok</rename><type>Integer</type><length>-1</length><precision>-1</precision><replace>N</replace></field></fields><cluster_schema/><remotesteps><input></input><output></output></remotesteps><GUI><xloc>915</xloc><yloc>40</yloc><draw>Y</draw></GUI></step>
<step><name>P07-F2 Vacios de genero, grupo etario y arma -&gt; SIN DATO</name><type>ScriptValueMod</type><description/><distribute>Y</distribute><custom_distribution/><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning><compatible>N</compatible><optimizationLevel>9</optimizationLevel><jsScripts><jsScript><jsScript_type>0</jsScript_type><jsScript_name>Transformacion</jsScript_name><jsScript_script>function cl(x) { if (x == null) return ''; return String(x).replace(/\s+/g, ' ').replace(/^ | $/g, ''); }
function norm(x) {
  var s = cl(x).toUpperCase();
  s = s.replace(/[ÁÀÂÄ]/g, 'A').replace(/[ÉÈÊË]/g, 'E').replace(/[ÍÌÎÏ]/g, 'I')
       .replace(/[ÓÒÔÖ]/g, 'O').replace(/[ÚÙÛÜ]/g, 'U').replace(/Ñ/g, 'N');
  return s;
}
function claveLoc(x) {
  var s = cl(x);
  if (/^[0-9]+(\.0+)?$/.test(s)) { s = s.replace(/\.0+$/, ''); return ('00' + s).slice(-2); }
  return norm(s);
}

arma_c = norm(arma_medio);    if (arma_c == '')   { arma_c = 'SIN DATO';   c_arma_vacio++; }
genero_c = norm(genero);      if (genero_c == '') { genero_c = 'SIN DATO'; c_genero_vacio++; }
grupo_c = norm(grupo_etario); if (grupo_c == '')  { grupo_c = 'SIN DATO';  c_grupo_vacio++; }</jsScript_script></jsScript><jsScript><jsScript_type>1</jsScript_type><jsScript_name>Inicio</jsScript_name><jsScript_script>var c_arma_vacio = 0;
var c_genero_vacio = 0;
var c_grupo_vacio = 0;</jsScript_script></jsScript><jsScript><jsScript_type>2</jsScript_type><jsScript_name>Fin</jsScript_name><jsScript_script>writeToLog('m', 'P07-F2 Vacios de genero, grupo etario y arma -&gt; SIN DATO | c_arma_vacio: ' + c_arma_vacio);
writeToLog('m', 'P07-F2 Vacios de genero, grupo etario y arma -&gt; SIN DATO | c_genero_vacio: ' + c_genero_vacio);
writeToLog('m', 'P07-F2 Vacios de genero, grupo etario y arma -&gt; SIN DATO | c_grupo_vacio: ' + c_grupo_vacio);</jsScript_script></jsScript></jsScripts><fields><field><name>arma_c</name><rename>arma_c</rename><type>String</type><length>-1</length><precision>-1</precision><replace>N</replace></field><field><name>genero_c</name><rename>genero_c</rename><type>String</type><length>-1</length><precision>-1</precision><replace>N</replace></field><field><name>grupo_c</name><rename>grupo_c</rename><type>String</type><length>-1</length><precision>-1</precision><replace>N</replace></field></fields><cluster_schema/><remotesteps><input></input><output></output></remotesteps><GUI><xloc>1090</xloc><yloc>40</yloc><draw>Y</draw></GUI></step>
<step><name>P08-F2 Tipificar tipo de hurto (articulo + descripcion)</name><type>ScriptValueMod</type><description/><distribute>Y</distribute><custom_distribution/><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning><compatible>N</compatible><optimizationLevel>9</optimizationLevel><jsScripts><jsScript><jsScript_type>0</jsScript_type><jsScript_name>Transformacion</jsScript_name><jsScript_script>function cl(x) { if (x == null) return ''; return String(x).replace(/\s+/g, ' ').replace(/^ | $/g, ''); }
function norm(x) {
  var s = cl(x).toUpperCase();
  s = s.replace(/[ÁÀÂÄ]/g, 'A').replace(/[ÉÈÊË]/g, 'E').replace(/[ÍÌÎÏ]/g, 'I')
       .replace(/[ÓÒÔÖ]/g, 'O').replace(/[ÚÙÛÜ]/g, 'U').replace(/Ñ/g, 'N');
  return s;
}
function claveLoc(x) {
  var s = cl(x);
  if (/^[0-9]+(\.0+)?$/.test(s)) { s = s.replace(/\.0+$/, ''); return ('00' + s).slice(-2); }
  return norm(s);
}

tipo_c = cl(tipo_hurto);
var p = tipo_c.indexOf('. ');
articulo_c = (p &gt; 0) ? tipo_c.substring(0, p) : 'SIN ARTICULO';
descripcion_c = (p &gt; 0) ? tipo_c.substring(p + 2) : tipo_c;
articulo_c = articulo_c.substring(0, 30);
descripcion_c = descripcion_c.substring(0, 100);
if (tipo_c == '') c_tipo_vacio++;
if (p &lt;= 0) c_tipo_sin_articulo++;
row_ok = (fecha_ok == 1 &amp;&amp; cant_ok == 1 &amp;&amp; tipo_c != '') ? 1 : 0;</jsScript_script></jsScript><jsScript><jsScript_type>1</jsScript_type><jsScript_name>Inicio</jsScript_name><jsScript_script>var c_tipo_vacio = 0;
var c_tipo_sin_articulo = 0;</jsScript_script></jsScript><jsScript><jsScript_type>2</jsScript_type><jsScript_name>Fin</jsScript_name><jsScript_script>writeToLog('m', 'P08-F2 Tipificar tipo de hurto (articulo + descripcion) | c_tipo_vacio: ' + c_tipo_vacio);
writeToLog('m', 'P08-F2 Tipificar tipo de hurto (articulo + descripcion) | c_tipo_sin_articulo: ' + c_tipo_sin_articulo);</jsScript_script></jsScript></jsScripts><fields><field><name>tipo_c</name><rename>tipo_c</rename><type>String</type><length>-1</length><precision>-1</precision><replace>N</replace></field><field><name>articulo_c</name><rename>articulo_c</rename><type>String</type><length>-1</length><precision>-1</precision><replace>N</replace></field><field><name>descripcion_c</name><rename>descripcion_c</rename><type>String</type><length>-1</length><precision>-1</precision><replace>N</replace></field><field><name>row_ok</name><rename>row_ok</rename><type>Integer</type><length>-1</length><precision>-1</precision><replace>N</replace></field></fields><cluster_schema/><remotesteps><input></input><output></output></remotesteps><GUI><xloc>1265</xloc><yloc>40</yloc><draw>Y</draw></GUI></step>
