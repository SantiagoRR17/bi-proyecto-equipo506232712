<step><name>Generar calendario 2010-2026</name><type>TableInput</type><description/><distribute>Y</distribute><custom_distribution/><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning><connection>dw</connection><sql>SELECT to_char(d,'YYYYMMDD')::int AS sk_tiempo, d::date AS fecha, EXTRACT(DAY FROM d)::int AS dia, (ARRAY['Enero','Febrero','Marzo','Abril','Mayo','Junio','Julio','Agosto','Septiembre','Octubre','Noviembre','Diciembre'])[EXTRACT(MONTH FROM d)::int] AS mes, EXTRACT(MONTH FROM d)::int AS numero_mes, EXTRACT(QUARTER FROM d)::int AS trimestre, EXTRACT(YEAR FROM d)::int AS anio FROM generate_series('2010-01-01'::date,'2026-12-31'::date, interval '1 day') AS d ORDER BY 1</sql><limit>0</limit><lookup/><execute_each_row>N</execute_each_row><variables_active>N</variables_active><lazy_conversion_active>N</lazy_conversion_active><cluster_schema/><remotesteps><input></input><output></output></remotesteps><GUI><xloc>40</xloc><yloc>40</yloc><draw>Y</draw></GUI></step>
