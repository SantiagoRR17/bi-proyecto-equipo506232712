<step><name>F1 turismo.geojson</name><type>JsonInput</type><description/><distribute>Y</distribute><custom_distribution/><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning><include>N</include><include_field/><rownum>N</rownum><addresultfile>N</addresultfile><readurl>N</readurl><removeSourceField>N</removeSourceField><IsIgnoreEmptyFile>N</IsIgnoreEmptyFile><doNotFailIfNoFile>N</doNotFailIfNoFile><ignoreMissingPath>Y</ignoreMissingPath><defaultPathLeafToNull>Y</defaultPathLeafToNull><rownum_field/><file><name>${RAIZ_REPO}/datos/raw/turismo.geojson</name><filemask/><exclude_filemask/><file_required>Y</file_required><include_subfolders>N</include_subfolders></file><fields><field><name>REGNTURISM</name><path>$.features[*].properties.REGNTURISM</path><type>String</type><format/><currency/><decimal/><group/><length>-1</length><precision>-1</precision><trim_type>none</trim_type><repeat>N</repeat></field><field><name>LOCALIDAD</name><path>$.features[*].properties.LOCALIDAD</path><type>String</type><format/><currency/><decimal/><group/><length>-1</length><precision>-1</precision><trim_type>none</trim_type><repeat>N</repeat></field><field><name>SUBCATRNT</name><path>$.features[*].properties.SUBCATRNT</path><type>String</type><format/><currency/><decimal/><group/><length>-1</length><precision>-1</precision><trim_type>none</trim_type><repeat>N</repeat></field></fields><limit>0</limit><IsInFields>N</IsInFields><IsAFile>N</IsAFile><valueField/><shortFileFieldName/><pathFieldName/><hiddenFieldName/><lastModificationTimeFieldName/><uriNameFieldName/><rootUriNameFieldName/><extensionFieldName/><sizeFieldName/><cluster_schema/><remotesteps><input></input><output></output></remotesteps><GUI><xloc>40</xloc><yloc>40</yloc><draw>Y</draw></GUI></step>
<step><name>C-F1-03 Descartar sin numero de registro RNT</name><type>FilterRows</type><description/><distribute>Y</distribute><custom_distribution/><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning><send_true_to>C-F1-04 Tipificar RNT y subcategoria</send_true_to><send_false_to>Rechazados F1 sin RNT</send_false_to><compare><condition><negated>N</negated><leftvalue>REGNTURISM</leftvalue><function>IS NOT NULL</function><rightvalue/></condition></compare><cluster_schema/><remotesteps><input></input><output></output></remotesteps><GUI><xloc>215</xloc><yloc>40</yloc><draw>Y</draw></GUI></step>
<step><name>Rechazados F1 sin RNT</name><type>Dummy</type><description/><distribute>Y</distribute><custom_distribution/><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning><cluster_schema/><remotesteps><input></input><output></output></remotesteps><GUI><xloc>390</xloc><yloc>40</yloc><draw>Y</draw></GUI></step>
<step><name>C-F1-04 Tipificar RNT y subcategoria</name><type>ScriptValueMod</type><description/><distribute>Y</distribute><custom_distribution/><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning><compatible>N</compatible><optimizationLevel>9</optimizationLevel><jsScripts><jsScript><jsScript_type>0</jsScript_type><jsScript_name>Transformacion</jsScript_name><jsScript_script>function cl(x) { if (x == null) return ''; return String(x).replace(/\s+/g, ' ').replace(/^ | $/g, ''); }
var r = parseInt(cl(REGNTURISM).replace(/\.0+$/, ''), 10);
reg_rnt = isNaN(r) ? null : r;
cod_subcategoria = cl(SUBCATRNT).replace(/\.0+$/, '');
sk_tiempo = parseInt(getVariable('FECHA_CORTE_TURISMO', '20261022'), 10);</jsScript_script></jsScript></jsScripts><fields><field><name>reg_rnt</name><rename>reg_rnt</rename><type>Integer</type><length>-1</length><precision>-1</precision><replace>N</replace></field><field><name>cod_subcategoria</name><rename>cod_subcategoria</rename><type>String</type><length>-1</length><precision>-1</precision><replace>N</replace></field><field><name>sk_tiempo</name><rename>sk_tiempo</rename><type>Integer</type><length>-1</length><precision>-1</precision><replace>N</replace></field></fields><cluster_schema/><remotesteps><input></input><output></output></remotesteps><GUI><xloc>390</xloc><yloc>140</yloc><draw>Y</draw></GUI></step>
<step><name>P01-F1 Completar LOCALIDAD a 2 digitos (3 -&gt; 03)</name><type>ScriptValueMod</type><description/><distribute>Y</distribute><custom_distribution/><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning><compatible>N</compatible><optimizationLevel>9</optimizationLevel><jsScripts><jsScript><jsScript_type>0</jsScript_type><jsScript_name>Transformacion</jsScript_name><jsScript_script>function cl(x) { if (x == null) return ''; return String(x).replace(/\s+/g, ' ').replace(/^ | $/g, ''); }
function norm(x) {
  var s = cl(x).toUpperCase();
  s = s.replace(/[ÁÀÂÄ]/g, 'A').replace(/[ÉÈÊË]/g, 'E').replace(/[ÍÌÎÏ]/g, 'I')
       .replace(/[ÓÒÔÖ]/g, 'O').replace(/[ÚÙÛÜ]/g, 'U').replace(/Ñ/g, 'N');
  return s;
}
function claveLoc(x) {
  var s = cl(x);
  if (/^[0-9]+(\.0+)?$/.test(s)) { s = s.replace(/\.0+$/, ''); return ('00' + s).slice(-2); }
  return norm(s);
}

var l0 = cl(LOCALIDAD);
clave_loc = claveLoc(l0);
if (/^[0-9]$/.test(l0)) c_sin_cero_izquierda++;
if (l0 == '') c_localidad_vacia++;</jsScript_script></jsScript><jsScript><jsScript_type>1</jsScript_type><jsScript_name>Inicio</jsScript_name><jsScript_script>var c_sin_cero_izquierda = 0;
var c_localidad_vacia = 0;</jsScript_script></jsScript><jsScript><jsScript_type>2</jsScript_type><jsScript_name>Fin</jsScript_name><jsScript_script>writeToLog('m', 'P01-F1 Completar LOCALIDAD a 2 digitos (3 -&gt; 03) | c_sin_cero_izquierda: ' + c_sin_cero_izquierda);
writeToLog('m', 'P01-F1 Completar LOCALIDAD a 2 digitos (3 -&gt; 03) | c_localidad_vacia: ' + c_localidad_vacia);</jsScript_script></jsScript></jsScripts><fields><field><name>clave_loc</name><rename>clave_loc</rename><type>String</type><length>-1</length><precision>-1</precision><replace>N</replace></field></fields><cluster_schema/><remotesteps><input></input><output></output></remotesteps><GUI><xloc>565</xloc><yloc>40</yloc><draw>Y</draw></GUI></step>
<step><name>P02-F1 Excluir geometria (EPSG:3857) y LATITUD/LONGITUD; solo se usa LOCALIDAD</name><type>SelectValues</type><description/><distribute>Y</distribute><custom_distribution/><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning><fields><field><name>reg_rnt</name><rename/><length>-2</length><precision>-2</precision></field><field><name>cod_subcategoria</name><rename/><length>-2</length><precision>-2</precision></field><field><name>sk_tiempo</name><rename/><length>-2</length><precision>-2</precision></field><field><name>clave_loc</name><rename/><length>-2</length><precision>-2</precision></field><select_unspecified>N</select_unspecified></fields><cluster_schema/><remotesteps><input></input><output></output></remotesteps><GUI><xloc>740</xloc><yloc>40</yloc><draw>Y</draw></GUI></step>
