<step><name>F4 geografia.json</name><type>JsonInput</type><description/><distribute>Y</distribute><custom_distribution/><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning><include>N</include><include_field/><rownum>N</rownum><addresultfile>N</addresultfile><readurl>N</readurl><removeSourceField>N</removeSourceField><IsIgnoreEmptyFile>N</IsIgnoreEmptyFile><doNotFailIfNoFile>N</doNotFailIfNoFile><ignoreMissingPath>Y</ignoreMissingPath><defaultPathLeafToNull>Y</defaultPathLeafToNull><rownum_field/><file><name>${RAIZ_REPO}/datos/raw/geografia.json</name><filemask/><exclude_filemask/><file_required>Y</file_required><include_subfolders>N</include_subfolders></file><fields><field><name>LocCodigo</name><path>$.features[*].attributes.LocCodigo</path><type>String</type><format/><currency/><decimal/><group/><length>-1</length><precision>-1</precision><trim_type>none</trim_type><repeat>N</repeat></field><field><name>LocNombre</name><path>$.features[*].attributes.LocNombre</path><type>String</type><format/><currency/><decimal/><group/><length>-1</length><precision>-1</precision><trim_type>none</trim_type><repeat>N</repeat></field><field><name>LocAAdmini</name><path>$.features[*].attributes.LocAAdmini</path><type>String</type><format/><currency/><decimal/><group/><length>-1</length><precision>-1</precision><trim_type>none</trim_type><repeat>N</repeat></field><field><name>LocArea</name><path>$.features[*].attributes.LocArea</path><type>Number</type><format/><currency/><decimal/><group/><length>-1</length><precision>-1</precision><trim_type>none</trim_type><repeat>N</repeat></field></fields><limit>0</limit><IsInFields>N</IsInFields><IsAFile>N</IsAFile><valueField/><shortFileFieldName/><pathFieldName/><hiddenFieldName/><lastModificationTimeFieldName/><uriNameFieldName/><rootUriNameFieldName/><extensionFieldName/><sizeFieldName/><cluster_schema/><remotesteps><input></input><output></output></remotesteps><GUI><xloc>40</xloc><yloc>40</yloc><draw>Y</draw></GUI></step>
<step><name>P15-F4 Excluir geometria (EPSG:4686) y conservar solo atributos</name><type>SelectValues</type><description/><distribute>Y</distribute><custom_distribution/><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning><fields><field><name>LocCodigo</name><rename/><length>-2</length><precision>-2</precision></field><field><name>LocNombre</name><rename/><length>-2</length><precision>-2</precision></field><field><name>LocAAdmini</name><rename/><length>-2</length><precision>-2</precision></field><field><name>LocArea</name><rename/><length>-2</length><precision>-2</precision></field><select_unspecified>N</select_unspecified></fields><cluster_schema/><remotesteps><input></input><output></output></remotesteps><GUI><xloc>215</xloc><yloc>40</yloc><draw>Y</draw></GUI></step>
<step><name>C-F4-01 Descartar registros sin codigo</name><type>FilterRows</type><description/><distribute>Y</distribute><custom_distribution/><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning><send_true_to>C-F4-02 Normalizar codigo (2 digitos) y textos</send_true_to><send_false_to>Rechazados F4 sin codigo</send_false_to><compare><condition><negated>N</negated><leftvalue>LocCodigo</leftvalue><function>IS NOT NULL</function><rightvalue/></condition></compare><cluster_schema/><remotesteps><input></input><output></output></remotesteps><GUI><xloc>390</xloc><yloc>40</yloc><draw>Y</draw></GUI></step>
<step><name>Rechazados F4 sin codigo</name><type>Dummy</type><description/><distribute>Y</distribute><custom_distribution/><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning><cluster_schema/><remotesteps><input></input><output></output></remotesteps><GUI><xloc>565</xloc><yloc>40</yloc><draw>Y</draw></GUI></step>
<step><name>C-F4-02 Normalizar codigo (2 digitos) y textos</name><type>ScriptValueMod</type><description/><distribute>Y</distribute><custom_distribution/><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning><compatible>N</compatible><optimizationLevel>9</optimizationLevel><jsScripts><jsScript><jsScript_type>0</jsScript_type><jsScript_name>Transformacion</jsScript_name><jsScript_script>function cl(x) { if (x == null) return ''; return String(x).replace(/\s+/g, ' ').replace(/^ | $/g, ''); }
function norm(x) {
  var s = cl(x).toUpperCase();
  s = s.replace(/[ÁÀÂÄ]/g, 'A').replace(/[ÉÈÊË]/g, 'E').replace(/[ÍÌÎÏ]/g, 'I')
       .replace(/[ÓÒÔÖ]/g, 'O').replace(/[ÚÙÛÜ]/g, 'U').replace(/Ñ/g, 'N');
  return s;
}
function claveLoc(x) {
  var s = cl(x);
  if (/^[0-9]+(\.0+)?$/.test(s)) { s = s.replace(/\.0+$/, ''); return ('00' + s).slice(-2); }
  return norm(s);
}

var c = claveLoc(LocCodigo);
cod_localidad = c;
cod_ok = /^[0-9]{2}$/.test(c) ? 1 : 0;
if (cl(LocCodigo) != c) c_codigo_ajustado++;
nombre_localidad = cl(LocNombre);
acto_administrativo = cl(LocAAdmini);
area = LocArea;
clave_loc = norm(LocNombre);</jsScript_script></jsScript><jsScript><jsScript_type>1</jsScript_type><jsScript_name>Inicio</jsScript_name><jsScript_script>var c_codigo_ajustado = 0;</jsScript_script></jsScript><jsScript><jsScript_type>2</jsScript_type><jsScript_name>Fin</jsScript_name><jsScript_script>writeToLog('m', 'C-F4-02 Normalizar codigo (2 digitos) y textos | c_codigo_ajustado: ' + c_codigo_ajustado);</jsScript_script></jsScript></jsScripts><fields><field><name>cod_localidad</name><rename>cod_localidad</rename><type>String</type><length>-1</length><precision>-1</precision><replace>N</replace></field><field><name>cod_ok</name><rename>cod_ok</rename><type>Integer</type><length>-1</length><precision>-1</precision><replace>N</replace></field><field><name>nombre_localidad</name><rename>nombre_localidad</rename><type>String</type><length>-1</length><precision>-1</precision><replace>N</replace></field><field><name>acto_administrativo</name><rename>acto_administrativo</rename><type>String</type><length>-1</length><precision>-1</precision><replace>N</replace></field><field><name>area</name><rename>area</rename><type>Number</type><length>-1</length><precision>-1</precision><replace>N</replace></field><field><name>clave_loc</name><rename>clave_loc</rename><type>String</type><length>-1</length><precision>-1</precision><replace>N</replace></field></fields><cluster_schema/><remotesteps><input></input><output></output></remotesteps><GUI><xloc>565</xloc><yloc>140</yloc><draw>Y</draw></GUI></step>
